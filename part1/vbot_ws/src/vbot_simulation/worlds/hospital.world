<?xml version="1.0"?>
<sdf version="1.6">
  <world name="vbot_hospital">
    <!-- 提供 /gazebo/set_entity_state，用于控制模拟行人横穿走廊。 -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>20.0</update_rate>
    </plugin>
    <gravity>0 0 -9.81</gravity>
    <physics name="fast" type="ode">
      <real_time_update_rate>500</real_time_update_rate>
      <max_step_size>0.002</max_step_size>
    </physics>
    <scene><ambient>0.7 0.7 0.7 1</ambient><background>0.92 0.94 0.96 1</background></scene>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- 12×8 米医院环境，包含中央走廊、诊室和门洞。 -->
    <model name="hospital_walls">
      <static>true</static>
      <link name="walls">
        <visual name="north"><pose>0 4 1.25 0 0 0</pose><geometry><box><size>12 0.12 2.5</size></box></geometry><material><ambient>0.82 0.86 0.90 1</ambient></material></visual>
        <collision name="north_c"><pose>0 4 1.25 0 0 0</pose><geometry><box><size>12 0.12 2.5</size></box></geometry></collision>
        <visual name="south"><pose>0 -4 1.25 0 0 0</pose><geometry><box><size>12 0.12 2.5</size></box></geometry><material><ambient>0.82 0.86 0.90 1</ambient></material></visual>
        <collision name="south_c"><pose>0 -4 1.25 0 0 0</pose><geometry><box><size>12 0.12 2.5</size></box></geometry></collision>
        <visual name="west"><pose>-6 0 1.25 0 0 0</pose><geometry><box><size>0.12 8 2.5</size></box></geometry><material><ambient>0.82 0.86 0.90 1</ambient></material></visual>
        <collision name="west_c"><pose>-6 0 1.25 0 0 0</pose><geometry><box><size>0.12 8 2.5</size></box></geometry></collision>
        <visual name="east"><pose>6 0 1.25 0 0 0</pose><geometry><box><size>0.12 8 2.5</size></box></geometry><material><ambient>0.82 0.86 0.90 1</ambient></material></visual>
        <collision name="east_c"><pose>6 0 1.25 0 0 0</pose><geometry><box><size>0.12 8 2.5</size></box></geometry></collision>

        <visual name="upper_left"><pose>-3.8 1.5 1.25 0 0 0</pose><geometry><box><size>4.4 0.12 2.5</size></box></geometry><material><ambient>0.75 0.85 0.92 1</ambient></material></visual>
        <collision name="upper_left_c"><pose>-3.8 1.5 1.25 0 0 0</pose><geometry><box><size>4.4 0.12 2.5</size></box></geometry></collision>
        <visual name="upper_right"><pose>3.8 1.5 1.25 0 0 0</pose><geometry><box><size>4.4 0.12 2.5</size></box></geometry><material><ambient>0.75 0.85 0.92 1</ambient></material></visual>
        <collision name="upper_right_c"><pose>3.8 1.5 1.25 0 0 0</pose><geometry><box><size>4.4 0.12 2.5</size></box></geometry></collision>
        <visual name="lower_left"><pose>-3.8 -1.5 1.25 0 0 0</pose><geometry><box><size>4.4 0.12 2.5</size></box></geometry><material><ambient>0.75 0.85 0.92 1</ambient></material></visual>
        <collision name="lower_left_c"><pose>-3.8 -1.5 1.25 0 0 0</pose><geometry><box><size>4.4 0.12 2.5</size></box></geometry></collision>
        <visual name="lower_right"><pose>3.8 -1.5 1.25 0 0 0</pose><geometry><box><size>4.4 0.12 2.5</size></box></geometry><material><ambient>0.75 0.85 0.92 1</ambient></material></visual>
        <collision name="lower_right_c"><pose>3.8 -1.5 1.25 0 0 0</pose><geometry><box><size>4.4 0.12 2.5</size></box></geometry></collision>

        <visual name="room_divider_n"><pose>0 2.75 1.25 0 0 0</pose><geometry><box><size>0.12 2.5 2.5</size></box></geometry><material><ambient>0.75 0.85 0.92 1</ambient></material></visual>
        <collision name="room_divider_n_c"><pose>0 2.75 1.25 0 0 0</pose><geometry><box><size>0.12 2.5 2.5</size></box></geometry></collision>
        <visual name="room_divider_s"><pose>0 -2.75 1.25 0 0 0</pose><geometry><box><size>0.12 2.5 2.5</size></box></geometry><material><ambient>0.75 0.85 0.92 1</ambient></material></visual>
        <collision name="room_divider_s_c"><pose>0 -2.75 1.25 0 0 0</pose><geometry><box><size>0.12 2.5 2.5</size></box></geometry></collision>
      </link>
    </model>

    <model name="dynamic_obstacle">
      <!-- 静态建图时停在走廊外；启用动态障碍测试后再由节点移入通道。 -->
      <pose>0 3 0.65 0 0 0</pose>
      <link name="body">
        <inertial><mass>60</mass><inertia><ixx>5</ixx><iyy>5</iyy><izz>5</izz></inertia></inertial>
        <visual name="visual"><geometry><cylinder><radius>0.28</radius><length>1.3</length></cylinder></geometry><material><ambient>0.9 0.35 0.12 1</ambient></material></visual>
        <collision name="collision"><geometry><cylinder><radius>0.28</radius><length>1.3</length></cylinder></geometry></collision>
      </link>
    </model>
  </world>
</sdf>
