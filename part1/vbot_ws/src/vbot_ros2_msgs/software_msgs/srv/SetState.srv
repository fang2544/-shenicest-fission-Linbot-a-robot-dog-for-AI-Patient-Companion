string fg_name  #function group name
string curr_state #Current function group state name
string target_state  #Target function group state name
#OTA transaction id. Empty for every non-OTA caller. Lets software_em treat a
#repeated request as the same attempt and answer from its recorded observation
#instead of re-running the switch.
string transaction_id

---

int32 OK = 0
int32 ERROR_CODE_UNKNOWN_FG = 1
int32 ERROR_CODE_UNSUPPORT_STATE = 2
int32 ERROR_CODE_UNSUPPORT_TRANS = 3
int32 ERROR_CODE_IN_SETTING_STATE = 4
int32 ERROR_CODE_SETTING_STATE_FAILED = 5

int32 error_code

