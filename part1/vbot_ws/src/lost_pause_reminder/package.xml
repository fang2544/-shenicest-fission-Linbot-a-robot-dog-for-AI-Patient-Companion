<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lost_pause_reminder</name>
  <version>0.2.0</version>
  <description>UWB 跟随目标丢失后暂停运动并提醒用户。</description>
  <maintainer email="developer@example.com">聆灵 VBot 二次开发团队</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>lowlevel_msg</exec_depend>
  <exec_depend>function_msgs</exec_depend>
  <exec_depend>speech_msgs</exec_depend>
  <exec_depend>peripheral_msgs</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
